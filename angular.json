{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "angular-eslint"
    ],
    "analytics": "2ccde468-0075-4259-aaa2-a5bf03f4f8b6"
  },
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "tsConfig": "tsconfig.app.json",

            "outputMode": "server",
            "ssr": {
              "entry": "server/main.js"
            },

            "define": {
              "GEMINI_API_KEY": "'YOUR_GEMINI_API_KEY'",
              "__dirname": "''"
            },

            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              }
            ],

            "styles": [
              "src/styles.css"
            ],

            "externalDependencies": [
              "@grpc/grpc-js",
              "@grpc/proto-loader",
              "firebase-admin",
              "firebase-admin/app",
              "firebase-admin/firestore",
              "razorpay",
              "bcryptjs",
              "jsonwebtoken",
              "express",
              "cors",
              "socket.io"
            ]
          },

          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb",
                  "maximumError": "12kb"
                }
              ],
              "outputHashing": "all"
            },

            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },

          "defaultConfiguration": "production"
        },

        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "development": {
              "buildTarget": "app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },

        "test": {
          "builder": "@angular/build:unit-test"
        },

        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "server/**/*.js"
            ]
          }
        }
      }
    }
  }
}