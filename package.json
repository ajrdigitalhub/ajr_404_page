{
  "name": "404-angular-app",
  "version": "0.0.0",
  "private": true,

  "engines": {
    "node": "22"
  },

  "scripts": {
    "ng": "ng",
    "dev": "concurrently \"cross-env PORT=3001 node server/server.js\" \"ng serve --port=3000 --host=0.0.0.0 --proxy-config proxy.conf.json\"",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "serve:ssr:app": "node dist/app/server/server.mjs"
  }
}